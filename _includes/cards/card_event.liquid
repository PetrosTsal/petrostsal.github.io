<div class="container card">
  {% if include.title %}
    <h1>{{ include.title }}</h1>
  {% endif %}
  <div class="badge-row">
    {% if include.location %}
      {% include badge.liquid
        img="/assets/img/icons/pin.svg"
        text="UOC, Computer Science Department"
      %}
    {% endif %}
    {% if include.when %}
      {% include badge.liquid
        img="/assets/img/icons/pin.svg"
        text="2-3 October 2025"
      %}
    {% endif %}
  </div>
  <p>{{ include.tag }}</p>
  <p>{{ include.text }}</p>
  <div class="page-buttons">
    <a href="" class="btn primary">Register</a>
  </div>
</div>
