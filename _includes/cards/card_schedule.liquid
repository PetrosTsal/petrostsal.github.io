<div class="container card schedule-grid">
  {% for day in include.schedule %}
    <div class="schedule-day">
      <h3 class="schedule-date">{{ day.date }}</h3>
      <div class="schedule-items">
        {% for item in day.items %}
          <div class="schedule-item size-{{ item.size }} {% if item.icon %}highlight{% endif %}">
            <div class="time">{{ item.time }}</div>
            <div class="text">
              {% if item.icon %}
                <span class="icon">💻</span>
              {% endif %}
              {{ item.title }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endfor %}
</div>
